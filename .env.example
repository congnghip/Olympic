# ==============================================================
# Environment Configuration Template for Olympic Waste Platform
# ==============================================================

# Server Network Configuration
HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
MAP_UI_PORT=8502

# Routing & OSRM Engine
OSRM_ENDPOINT=https://router.project-osrm.org
ROUTE_CACHE_ENABLED=true

# AI & Incident Dispatching (Kev System One)
KEV_API_URL=http://127.0.0.1:8009/v1/systemone
KEV_MODEL_VERSION=kev-latest

# Environment mode: development | production
APP_ENV=production
DEBUG=false
